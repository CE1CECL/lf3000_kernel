-include ../makefile.defs

# Add inputs and outputs from these tool invocations to the build variables 
SECONDARY_FLASH += \
nxp4330_linux-3.4.5.hex \

SECONDARY_LIST += \
nxp4330_linux-3.4.5.lst \

SECONDARY_SIZE += \
nxp4330_linux-3.4.5.siz \


# All Target
all: nxp4330_linux-3.4.5.elf secondary-outputs

# Tool invocations
nxp4330_linux-3.4.5.elf: $(OBJS) $(USER_OBJS)
	@echo 'Building target: $@'
	@echo 'Invoking: ARM Linux GCC C Linker'
	arm-elf-gcc -nostartfiles -Wl,-Map,nxp4330_linux-3.4.5.map -mcpu=cortex-m4 -mthumb -g3 -gdwarf-2 -o "nxp4330_linux-3.4.5.elf" $(OBJS) $(USER_OBJS) $(LIBS)
	@echo 'Finished building target: $@'
	@echo ' '

nxp4330_linux-3.4.5.hex: nxp4330_linux-3.4.5.elf
	@echo 'Invoking: ARM Linux GNU Create Flash Image'
	arm-elf-objcopy -O ihex nxp4330_linux-3.4.5.elf  "nxp4330_linux-3.4.5.hex"
	@echo 'Finished building: $@'
	@echo ' '

nxp4330_linux-3.4.5.lst: nxp4330_linux-3.4.5.elf
	@echo 'Invoking: ARM Linux GNU Create Listing'
	arm-elf-objdump -h -S nxp4330_linux-3.4.5.elf > "nxp4330_linux-3.4.5.lst"
	@echo 'Finished building: $@'
	@echo ' '

nxp4330_linux-3.4.5.siz: nxp4330_linux-3.4.5.elf
	@echo 'Invoking: ARM Linux GNU Print Size'
	arm-elf-size  --format=berkeley nxp4330_linux-3.4.5.elf
	@echo 'Finished building: $@'
	@echo ' '

# Other Targets
clean:
	-$(RM) $(SECONDARY_SIZE)$(OBJS)$(C_DEPS)$(ASM_DEPS)$(SECONDARY_FLASH)$(EXECUTABLES)$(SECONDARY_LIST)$(S_UPPER_DEPS) nxp4330_linux-3.4.5.elf
	-@echo ' '

secondary-outputs: $(SECONDARY_FLASH) $(SECONDARY_LIST) $(SECONDARY_SIZE)

.PHONY: all clean dependents
.SECONDARY:

-include ../makefile.targets
